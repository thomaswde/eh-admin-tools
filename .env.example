# ExtraHop Admin Tools saved connections
#
# Copy this file to .env in the same directory, replace the example values,
# and restart the app. Increase the numeric index to add more connections.
# The .env file contains plaintext credentials and is ignored by Git. Manual
# connections entered in the UI are stored in the operating-system keychain.

# RevealX 360 example
EH_CONNECTION_360_1_TENANT=hoolicorp
EH_CONNECTION_360_1_API_ID="replace-with-api-id"
EH_CONNECTION_360_1_API_SECRET="replace-with-api-secret"

# RevealX Enterprise example
EH_CONNECTION_ENTERPRISE_1_HOST=extrahop.company.com
EH_CONNECTION_ENTERPRISE_1_API_KEY="replace-with-api-key"
EH_CONNECTION_ENTERPRISE_1_VERIFY_TLS=true

# Optional completed-report cache limits and location. Defaults are 32 MiB per
# report and 512 MiB across one local user's connections. In a packaged install,
# the default directory is api-response-cache beside the README.
# EH_REPORT_CACHE_DIR=/path/to/api-response-cache
# EH_REPORT_CACHE_MAX_ENTRY_BYTES=33554432
# EH_REPORT_CACHE_MAX_USER_BYTES=536870912
# EH_REPORT_CACHE_MAX_CONNECTIONS=64
